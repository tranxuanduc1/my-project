# Docker Compose network configuration.
PORT=8082
DATABASE_URL=postgres://postgres:postgres@postgres:5432/orders?sslmode=disable
MIGRATIONS_PATH=file://migrations
JWT_SECRET=local-development-jwt-secret-change-me
INTERNAL_API_KEY=local-development-internal-key
REDIS_ADDR=redis:6379
RABBITMQ_URL=amqp://app:app@rabbitmq:5672/
PAYMENT_URL=http://payment:8083
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=local-development-master-key
MINIO_ENDPOINT=minio:9000
# Presigned URLs are opened from the host, not from the Docker network.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
